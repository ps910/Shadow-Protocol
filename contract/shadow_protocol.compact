/**
 * @file Shadow Protocol — Privacy-First Social Deduction Game on Midnight Network
 * @description A multiplayer hidden-role strategy game set aboard Aegis Station.
 *              Players complete tasks, investigate rooms, sabotage systems, and hold
 *              emergency meetings — while Midnight cryptographically verifies roles,
 *              task nullifiers, cryptographic alibis, and shielded voting.
 *
 * Privacy Model:
 * - PUBLIC:  gamePhase, roundNumber, playerCount, taskProgressCounter, activeSabotage, aliveStatus, voteResults, gameOutcome
 * - PRIVATE: playerRole (witness), taskNullifiers (zk-proof), room beacons (alibis), individual votes
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================
// Ledger State (PUBLIC — visible on-chain)
// ============================================================

// Unique game identifier
export ledger gameId: Bytes<32>;

// Current game phase: 0=Lobby, 1=FreeRoam, 2=EmergencyMeeting, 3=Voting, 4=Ended
export ledger gamePhase: Uint<8>;

// Current round number
export ledger roundNumber: Counter;

// Total players in the game
export ledger playerCount: Counter;

// Global task completion progress counter
export ledger taskProgressCounter: Counter;

// Active sabotage flag: 0=None, 1=ReactorMeltdown, 2=CommsOffline
export ledger activeSabotage: Uint<8>;

// Tracks player commitments (hash of secret + role)
export ledger playerCommitments: Map<Field, Boolean>;

// Tracks alive/dead status per player commitment
export ledger aliveStatus: Map<Field, Boolean>;

// Tracks used action nullifiers (prevents double-actions per round)
export ledger usedActionNullifiers: Map<Field, Boolean>;

// Tracks used task nullifiers (prevents replay of completed tasks)
export ledger usedTaskNullifiers: Map<Field, Boolean>;

// Tracks used vote nullifiers (prevents double-voting)
export ledger usedVoteNullifiers: Map<Field, Boolean>;

// Vote tallies per round (commitment → vote count)
export ledger voteTally: Map<Field, Uint<64>>;

// Game outcome: 0=ongoing, 1=protocol_wins, 2=shadow_wins
export ledger gameOutcome: Uint<8>;

// Human-readable game name
export ledger gameName: Opaque<"string">;

// ============================================================
// Witnesses (PRIVATE — never leave the user's device)
// ============================================================

// The player's secret key — known only to the player
witness playerSecret(): Bytes<32>;

// The player's assigned role — known only to the player
witness playerRole(): Bytes<32>;

// The player's night action target — private
witness actionTarget(): Bytes<32>;

// Private task identifier witness
witness taskSecret(): Bytes<32>;

// ============================================================
// Constructor
// ============================================================

constructor(name: Opaque<"string">) {
    gameName = name;
    gamePhase = 0;        // Lobby
    gameOutcome = 0;      // Ongoing
    activeSabotage = 0;   // No active sabotage
    roundNumber.increment(0);
    playerCount.increment(0);
    taskProgressCounter.increment(0);
}

// ============================================================
// Circuits
// ============================================================

/**
 * joinGame — Register a player with their commitment
 */
export circuit joinGame(commitment: Bytes<32>): [] {
    const commitField = persistentHash<Bytes<32>>([commitment]);
    playerCommitments.insert(commitField, true);
    aliveStatus.insert(commitField, true);
    playerCount.increment(1);
}

/**
 * submitTaskCompletion — Verify and register a completed mini-game task
 *
 * PRIVACY: The task nullifier is single-use and generated via
 * Poseidon(playerSecret, taskId, round). The public ledger sees the global
 * task counter increment without learning WHO solved it or in WHICH ROOM.
 */
export circuit submitTaskCompletion(taskNullifier: Bytes<32>): [] {
    const nullifierField = persistentHash<Bytes<32>>([taskNullifier]);

    // Verify task nullifier has not already been used
    assert(!usedTaskNullifiers.member(nullifierField),
           "Task nullifier has already been redeemed");

    usedTaskNullifiers.insert(nullifierField, true);
    taskProgressCounter.increment(1);
}

/**
 * triggerSabotage — Initiate a station sabotage (Reactor or Comms)
 */
export circuit triggerSabotage(sabotageType: Uint<8>): [] {
    activeSabotage = disclose(sabotageType);
}

/**
 * resolveSabotage — Clear active sabotage after crew stabilizes the system
 */
export circuit resolveSabotage(): [] {
    activeSabotage = 0;
}

/**
 * reportEmergency — Trigger an Emergency Meeting
 */
export circuit reportEmergency(roomIndex: Uint<8>): [] {
    gamePhase = 2; // Emergency Meeting
}

/**
 * submitNightAction — Submit a private action (eliminate/protect/investigate)
 */
export circuit submitNightAction(actionHash: Bytes<32>): [] {
    const secret = playerSecret();
    const nullifier = transientHash<Bytes<32>>([secret]);

    assert(!usedActionNullifiers.member(nullifier),
           "Already submitted action this cycle");

    usedActionNullifiers.insert(nullifier, true);
}

/**
 * submitVote — Submit a confidential shielded vote
 */
export circuit submitVote(voteCommitment: Bytes<32>): [] {
    const secret = playerSecret();
    const voteNullifier = transientHash<Bytes<32>>([secret]);

    assert(!usedVoteNullifiers.member(voteNullifier),
           "Already voted this round");

    usedVoteNullifiers.insert(voteNullifier, true);
}

/**
 * updateGamePhase — Update the game phase
 */
export circuit updateGamePhase(newPhase: Uint<8>): [] {
    gamePhase = disclose(newPhase);
}

/**
 * setGameOutcome — Record the final game result
 */
export circuit setGameOutcome(outcome: Uint<8>): [] {
    gameOutcome = disclose(outcome);
}

/**
 * advanceRound — Move to the next round
 */
export circuit advanceRound(): [] {
    roundNumber.increment(1);
}

/**
 * getPlayerCount — Read-only query for player count
 */
export circuit getPlayerCount(): Uint<64> {
    return playerCount.value();
}

/**
 * getTaskProgress — Read-only query for completed tasks count
 */
export circuit getTaskProgress(): Uint<64> {
    return taskProgressCounter.value();
}

/**
 * getActiveSabotage — Read-only query for active sabotage state
 */
export circuit getActiveSabotage(): Uint<8> {
    return activeSabotage;
}

/**
 * getRoundNumber — Read-only query for round number
 */
export circuit getRoundNumber(): Uint<64> {
    return roundNumber.value();
}
